---
import { architecture } from '../data/content';
---

<section id="architecture" class="py-24 sm:py-32 bg-[#050508] border-b border-white/[0.06] relative overflow-hidden">
  <div class="absolute inset-0 grid-subtle opacity-15 pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 scroll-reveal">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#8B5CF6]/10 border border-[#8B5CF6]/30 text-xs font-mono text-[#8B5CF6] mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-[#8B5CF6]"></span>
        <span>{architecture.eyebrow}</span>
      </div>
      <h2 class="display-section text-white tracking-tight">
        {architecture.title}
      </h2>
      <p class="mt-4 text-sm sm:text-base text-zinc-400 leading-relaxed">
        {architecture.subtitle}
      </p>
    </div>

    <!-- Animated SVG Flow Diagram -->
    <div class="max-w-5xl mx-auto mb-16 scroll-reveal">
      <div class="dl-card rounded-2xl p-6 sm:p-8 overflow-hidden relative">
        <div class="absolute inset-0 grid-dense opacity-[0.04] pointer-events-none"></div>
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-6">
            <div class="text-[10px] font-mono font-bold text-zinc-400 uppercase tracking-wider">DATA FLOW TOPOLOGY</div>
            <div class="flex items-center gap-3 text-[9px] font-mono text-zinc-600">
              <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-[#00D4FF]"></span> On-Device</span>
              <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-[#8B5CF6]"></span> Bridge</span>
              <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span> Execution</span>
              <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-[#F59E0B]"></span> Cloud (on demand)</span>
            </div>
          </div>

          <div class="relative w-full" style="aspect-ratio: 900 / 440;">
            <svg id="arch-flow-svg" class="w-full h-full" viewBox="0 0 900 440" fill="none" xmlns="http://www.w3.org/2000/svg">

              <!-- ═══════ PHONE LAYER (LEFT) ═══════ -->
              <rect x="20" y="20" width="260" height="400" rx="16" fill="#080910" stroke="#00D4FF" stroke-width="1" opacity="0.4" class="topo-zone" />
              <text x="150" y="46" text-anchor="middle" fill="#00D4FF" font-family="JetBrains Mono, monospace" font-size="9" font-weight="700" letter-spacing="0.1em">iQOO PHONE — THE BRAIN</text>

              <!-- Camera -->
              <rect x="40" y="64" width="100" height="52" rx="8" fill="#0C0D14" stroke="#00D4FF" stroke-width="1.2" class="arch-node" />
              <text x="90" y="84" text-anchor="middle" fill="#00D4FF" font-family="JetBrains Mono, monospace" font-size="8" font-weight="600">CameraX</text>
              <text x="90" y="100" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="6.5">50MP · <100ms</text>

              <!-- Voice -->
              <rect x="160" y="64" width="100" height="52" rx="8" fill="#0C0D14" stroke="#00D4FF" stroke-width="1.2" class="arch-node" />
              <text x="210" y="84" text-anchor="middle" fill="#00D4FF" font-family="JetBrains Mono, monospace" font-size="8" font-weight="600">ML Kit Speech</text>
              <text x="210" y="100" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="6.5">On-Device ASR</text>

              <!-- ML Kit OCR -->
              <rect x="40" y="132" width="100" height="44" rx="8" fill="#0C0D14" stroke="#00D4FF" stroke-width="0.8" />
              <text x="90" y="150" text-anchor="middle" fill="#94A3B8" font-family="JetBrains Mono, monospace" font-size="7" font-weight="600">ML Kit OCR v2</text>
              <text x="90" y="164" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="6">Text Recognition</text>

              <!-- Gemini Nano -->
              <rect x="160" y="132" width="100" height="44" rx="8" fill="#0C0D14" stroke="#00D4FF" stroke-width="0.8" />
              <text x="210" y="150" text-anchor="middle" fill="#94A3B8" font-family="JetBrains Mono, monospace" font-size="7" font-weight="600">Gemini Nano</text>
              <text x="210" y="164" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="6">AICore · NPU</text>

              <!-- Context Engine -->
              <rect x="60" y="196" width="180" height="52" rx="10" fill="#0A0E18" stroke="#00D4FF" stroke-width="1.5" class="arch-node" />
              <text x="150" y="218" text-anchor="middle" fill="#00D4FF" font-family="JetBrains Mono, monospace" font-size="9" font-weight="700">Context Engine</text>
              <text x="150" y="234" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="6.5">Classify · Route · Hypothesis</text>

              <!-- Intent Router -->
              <rect x="60" y="266" width="180" height="44" rx="8" fill="#0C0D14" stroke="#00D4FF" stroke-width="0.8" />
              <text x="150" y="284" text-anchor="middle" fill="#94A3B8" font-family="JetBrains Mono, monospace" font-size="7" font-weight="600">Intent Router</text>
              <text x="150" y="298" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="6">fix · explain · test · undo</text>

              <!-- Compose UI -->
              <rect x="60" y="328" width="180" height="52" rx="10" fill="#0C0D14" stroke="#00D4FF" stroke-width="0.8" />
              <text x="150" y="348" text-anchor="middle" fill="#94A3B8" font-family="JetBrains Mono, monospace" font-size="7" font-weight="600">Jetpack Compose UI</text>
              <text x="150" y="364" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="6">Camera · Chat · Status · Results</text>

              <!-- Internal phone arrows -->
              <line x1="90" y1="116" x2="90" y2="132" stroke="#00D4FF" stroke-width="0.7" opacity="0.4" />
              <line x1="210" y1="116" x2="210" y2="132" stroke="#00D4FF" stroke-width="0.7" opacity="0.4" />
              <line x1="90" y1="176" x2="130" y2="196" stroke="#00D4FF" stroke-width="0.7" opacity="0.4" />
              <line x1="210" y1="176" x2="170" y2="196" stroke="#00D4FF" stroke-width="0.7" opacity="0.4" />
              <line x1="150" y1="248" x2="150" y2="266" stroke="#00D4FF" stroke-width="0.7" opacity="0.4" />
              <line x1="150" y1="310" x2="150" y2="328" stroke="#00D4FF" stroke-width="0.7" opacity="0.4" />

              <!-- ═══════ BRIDGE (CENTER) ═══════ -->
              <rect x="320" y="170" width="130" height="100" rx="14" fill="#0A0A18" stroke="#8B5CF6" stroke-width="1.5" stroke-dasharray="6 3" class="arch-node" />
              <text x="385" y="206" text-anchor="middle" fill="#8B5CF6" font-family="JetBrains Mono, monospace" font-size="9" font-weight="700">WebSocket</text>
              <text x="385" y="222" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="6.5">OkHttp ↔ ws</text>
              <text x="385" y="238" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="6.5">Local Wi-Fi</text>
              <text x="385" y="256" text-anchor="middle" fill="#8B5CF6" font-family="JetBrains Mono, monospace" font-size="6" opacity="0.6">< 5ms</text>

              <!-- Office Kit -->
              <rect x="330" y="296" width="110" height="36" rx="8" fill="#0C0D14" stroke="#8B5CF6" stroke-width="0.8" />
              <text x="385" y="312" text-anchor="middle" fill="#8B5CF6" font-family="JetBrains Mono, monospace" font-size="7" font-weight="600">Office Kit</text>
              <text x="385" y="324" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="5.5">Mirror · Clipboard · Files</text>

              <!-- Bridge connection to phone -->
              <path d="M 240 220 C 270 220, 290 220, 320 220" stroke="#00D4FF" stroke-width="1.5" stroke-dasharray="5 3" class="arch-line" />
              <polygon points="316,216 316,224 324,220" fill="#00D4FF" opacity="0.6" />

              <!-- Bridge return path (results) -->
              <path d="M 320 230 C 290 230, 270 236, 240 240" stroke="#8B5CF6" stroke-width="1" stroke-dasharray="4 3" class="arch-line" opacity="0.5" />
              <polygon points="244,236 244,244 236,240" fill="#8B5CF6" opacity="0.4" />

              <!-- Bridge connection to laptop -->
              <path d="M 450 220 C 480 220, 500 220, 530 220" stroke="#10B981" stroke-width="1.5" stroke-dasharray="5 3" class="arch-line" />
              <polygon points="526,216 526,224 534,220" fill="#10B981" opacity="0.6" />

              <!-- Laptop return path -->
              <path d="M 530 230 C 500 230, 480 236, 450 240" stroke="#F59E0B" stroke-width="1" stroke-dasharray="4 3" class="arch-line" opacity="0.5" />
              <polygon points="454,236 454,244 446,240" fill="#F59E0B" opacity="0.4" />

              <!-- Animated particles on main paths -->
              <circle id="topo-p1" cx="240" cy="220" r="3.5" fill="#00D4FF" opacity="0.9">
                <animate attributeName="opacity" values="0.9;0.4;0.9" dur="1.5s" repeatCount="indefinite" />
              </circle>
              <circle id="topo-p2" cx="450" cy="220" r="3.5" fill="#10B981" opacity="0.9">
                <animate attributeName="opacity" values="0.9;0.4;0.9" dur="1.8s" repeatCount="indefinite" />
              </circle>
              <circle id="topo-p3" cx="320" cy="230" r="2.5" fill="#8B5CF6" opacity="0.6">
                <animate attributeName="opacity" values="0.6;0.2;0.6" dur="2s" repeatCount="indefinite" />
              </circle>
              <circle id="topo-p4" cx="530" cy="230" r="2.5" fill="#F59E0B" opacity="0.6">
                <animate attributeName="opacity" values="0.6;0.2;0.6" dur="2.2s" repeatCount="indefinite" />
              </circle>

              <!-- ═══════ LAPTOP LAYER (RIGHT) ═══════ -->
              <rect x="530" y="20" width="350" height="400" rx="16" fill="#080910" stroke="#10B981" stroke-width="1" opacity="0.4" class="topo-zone" />
              <text x="705" y="46" text-anchor="middle" fill="#10B981" font-family="JetBrains Mono, monospace" font-size="9" font-weight="700" letter-spacing="0.1em">LAPTOP DAEMON — THE HANDS</text>

              <!-- Agent Orchestrator -->
              <rect x="570" y="64" width="280" height="52" rx="10" fill="#0A0E18" stroke="#10B981" stroke-width="1.5" class="arch-node" />
              <text x="710" y="86" text-anchor="middle" fill="#10B981" font-family="JetBrains Mono, monospace" font-size="9" font-weight="700">Agent Orchestrator</text>
              <text x="710" y="102" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="6.5">Intent → Tool Selection → Execution → Verify</text>

              <!-- Tool Row 1 -->
              <rect x="555" y="132" width="82" height="44" rx="8" fill="#0C0D14" stroke="#10B981" stroke-width="0.8" />
              <text x="596" y="150" text-anchor="middle" fill="#94A3B8" font-family="JetBrains Mono, monospace" font-size="7" font-weight="600">FileSearch</text>
              <text x="596" y="164" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="5.5">glob + ripgrep</text>

              <rect x="649" y="132" width="82" height="44" rx="8" fill="#0C0D14" stroke="#10B981" stroke-width="0.8" />
              <text x="690" y="150" text-anchor="middle" fill="#94A3B8" font-family="JetBrains Mono, monospace" font-size="7" font-weight="600">Terminal</text>
              <text x="690" y="164" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="5.5">node-pty</text>

              <rect x="743" y="132" width="82" height="44" rx="8" fill="#0C0D14" stroke="#10B981" stroke-width="0.8" />
              <text x="784" y="150" text-anchor="middle" fill="#94A3B8" font-family="JetBrains Mono, monospace" font-size="7" font-weight="600">Git</text>
              <text x="784" y="164" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="5.5">simple-git</text>

              <!-- Tool Row 2 -->
              <rect x="555" y="190" width="82" height="44" rx="8" fill="#0C0D14" stroke="#10B981" stroke-width="0.8" />
              <text x="596" y="208" text-anchor="middle" fill="#94A3B8" font-family="JetBrains Mono, monospace" font-size="7" font-weight="600">Patch</text>
              <text x="596" y="222" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="5.5">fs + stash</text>

              <rect x="649" y="190" width="82" height="44" rx="8" fill="#0C0D14" stroke="#10B981" stroke-width="0.8" />
              <text x="690" y="208" text-anchor="middle" fill="#94A3B8" font-family="JetBrains Mono, monospace" font-size="7" font-weight="600">TestRunner</text>
              <text x="690" y="222" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="5.5">spawn + parse</text>

              <rect x="743" y="190" width="82" height="44" rx="8" fill="#0C0D14" stroke="#10B981" stroke-width="0.8" />
              <text x="784" y="208" text-anchor="middle" fill="#94A3B8" font-family="JetBrains Mono, monospace" font-size="7" font-weight="600">FileRead</text>
              <text x="784" y="222" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="5.5">fs.readFile</text>

              <!-- Orchestrator to tools arrows -->
              <line x1="650" y1="116" x2="596" y2="132" stroke="#10B981" stroke-width="0.6" opacity="0.3" />
              <line x1="710" y1="116" x2="690" y2="132" stroke="#10B981" stroke-width="0.6" opacity="0.3" />
              <line x1="770" y1="116" x2="784" y2="132" stroke="#10B981" stroke-width="0.6" opacity="0.3" />

              <!-- Cloud AI (OpenRouter) — conditional -->
              <rect x="600" y="260" width="220" height="56" rx="10" fill="#0C0D14" stroke="#F59E0B" stroke-width="1.2" stroke-dasharray="4 3" class="arch-node" />
              <text x="710" y="284" text-anchor="middle" fill="#F59E0B" font-family="JetBrains Mono, monospace" font-size="8" font-weight="700">☁ OpenRouter API</text>
              <text x="710" y="300" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="6">Claude · GPT-4 · Gemini · 400+ models</text>
              <text x="710" y="312" text-anchor="middle" fill="#F59E0B" font-family="JetBrains Mono, monospace" font-size="5.5" opacity="0.5">ONLY WHEN ON-DEVICE INSUFFICIENT</text>

              <!-- Conditional routing line -->
              <path d="M 710 234 L 710 260" stroke="#F59E0B" stroke-width="0.8" stroke-dasharray="3 3" opacity="0.4" />
              <text x="726" y="250" fill="#F59E0B" font-family="JetBrains Mono, monospace" font-size="5" opacity="0.4">if complex</text>

              <!-- Results stream -->
              <rect x="600" y="336" width="220" height="48" rx="10" fill="#0A0E18" stroke="#10B981" stroke-width="1" />
              <text x="710" y="356" text-anchor="middle" fill="#10B981" font-family="JetBrains Mono, monospace" font-size="8" font-weight="700">Results Stream</text>
              <text x="710" y="372" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="6">progress · patch · test results · summary</text>

              <!-- Flow labels -->
              <text x="290" y="210" text-anchor="middle" fill="#00D4FF" font-family="JetBrains Mono, monospace" font-size="6" opacity="0.6">commands →</text>
              <text x="290" y="250" text-anchor="middle" fill="#8B5CF6" font-family="JetBrains Mono, monospace" font-size="6" opacity="0.4">← results</text>
              <text x="490" y="210" text-anchor="middle" fill="#10B981" font-family="JetBrains Mono, monospace" font-size="6" opacity="0.6">execute →</text>
              <text x="490" y="250" text-anchor="middle" fill="#F59E0B" font-family="JetBrains Mono, monospace" font-size="6" opacity="0.4">← stream</text>

            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Traditional vs Inverted -->
    <div class="max-w-4xl mx-auto mb-16 grid md:grid-cols-2 gap-6 scroll-reveal">
      <!-- Traditional -->
      <div class="dl-card rounded-xl p-6 border-l-4 border-l-[#F43F5E]/50 opacity-50 hover:opacity-70 transition-opacity duration-300">
        <div class="font-mono text-xs font-bold text-[#F43F5E] uppercase tracking-wider mb-3 flex items-center gap-2">
          <span>✗</span>
          <span>{architecture.traditional.label}</span>
        </div>
        <p class="text-xs text-zinc-500 font-mono leading-relaxed">{architecture.traditional.flow}</p>
        <div class="mt-4 text-center font-mono text-[10px] text-zinc-600">
          Intelligence in the cloud · Developer manually bridges
        </div>
      </div>

      <!-- Inverted -->
      <div class="dl-card rounded-xl p-6 border-l-4 border-l-[#00D4FF] dl-card-active">
        <div class="font-mono text-xs font-bold text-[#00D4FF] uppercase tracking-wider mb-3 flex items-center gap-2">
          <span>✓</span>
          <span>{architecture.inverted.label}</span>
        </div>
        <p class="text-xs text-zinc-300 font-mono leading-relaxed">{architecture.inverted.flow}</p>
        <div class="mt-4 text-center font-mono text-[10px] text-[#00D4FF]/60">
          Intelligence on-device · Execution on laptop · Zero manual bridging
        </div>
      </div>
    </div>

    <!-- Architecture Nodes Detail -->
    <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto scroll-reveal-group">
      {architecture.nodes.map((node, idx) => (
        <div class="dl-card rounded-xl p-6 scroll-reveal gradient-border relative group">
          <div class="flex items-center gap-3 mb-5 pb-4 border-b border-white/[0.06]">
            <div class="text-3xl transition-transform duration-300 group-hover:scale-110">{node.icon}</div>
            <div>
              <h3 class="font-heading font-bold text-white text-base">{node.name}</h3>
              <p class="font-mono text-[10px] text-zinc-500">{node.subtitle}</p>
            </div>
          </div>

          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-white/[0.05] border border-white/[0.08] text-[10px] font-mono font-bold tracking-wider mb-4" style={`color: ${node.accent}`}>
            <span class="w-1.5 h-1.5 rounded-full" style={`background: ${node.accent}`}></span>
            {node.role}
          </div>

          <div class="space-y-2.5">
            {node.specs.map((spec) => (
              <div class="flex items-start justify-between gap-2 text-xs group/spec">
                <span class="text-zinc-500 shrink-0">{spec.label}</span>
                <span class="text-zinc-300 text-right font-mono text-[11px] group-hover/spec:text-white transition-colors duration-200">{spec.value}</span>
              </div>
            ))}
          </div>

          {idx < architecture.nodes.length - 1 && (
            <div class="hidden md:flex absolute -right-3 top-1/2 -translate-y-1/2 z-20">
              <svg class="w-6 h-6 text-[#00D4FF]/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Intelligence Routing -->
    <div class="mt-16 max-w-4xl mx-auto scroll-reveal">
      <div class="dl-card rounded-xl p-6 sm:p-8">
        <div class="text-[10px] font-mono font-bold text-zinc-400 uppercase tracking-wider mb-4">INTELLIGENCE ROUTING</div>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="rounded-lg bg-[#00D4FF]/5 border border-[#00D4FF]/20 p-4 transition-all duration-300 hover:bg-[#00D4FF]/[0.08] hover:border-[#00D4FF]/40">
            <div class="font-mono text-xs font-bold text-[#00D4FF] mb-2">LOCAL (Phone NPU)</div>
            <ul class="space-y-1.5 text-xs text-zinc-400 font-mono">
              <li>→ OCR text extraction</li>
              <li>→ Speech recognition</li>
              <li>→ Error classification</li>
              <li>→ Intent extraction</li>
              <li>→ Privacy-sensitive analysis</li>
            </ul>
            <div class="mt-3 text-[10px] font-mono text-[#00D4FF]/60">Simple + Private = On-Device</div>
          </div>
          <div class="rounded-lg bg-[#8B5CF6]/5 border border-[#8B5CF6]/20 p-4 transition-all duration-300 hover:bg-[#8B5CF6]/[0.08] hover:border-[#8B5CF6]/40">
            <div class="font-mono text-xs font-bold text-[#8B5CF6] mb-2">CLOUD (OpenRouter)</div>
            <ul class="space-y-1.5 text-xs text-zinc-400 font-mono">
              <li>→ Multi-file debugging</li>
              <li>→ Complex patch generation</li>
              <li>→ Architecture analysis</li>
              <li>→ Repository mapping</li>
              <li>→ Long reasoning chains</li>
            </ul>
            <div class="mt-3 text-[10px] font-mono text-[#8B5CF6]/60">Complex Reasoning = Cloud AI</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate } from 'animejs';

  document.addEventListener('DOMContentLoaded', () => {
    // Animated data particles traveling between nodes
    animate('#topo-p1', {
      cx: [240, 316],
      duration: 1400,
      ease: 'inOutSine',
      alternate: true,
      loop: true,
    });

    animate('#topo-p2', {
      cx: [450, 530],
      duration: 1600,
      ease: 'inOutSine',
      alternate: true,
      loop: true,
    });

    animate('#topo-p3', {
      cx: [320, 244],
      duration: 1800,
      ease: 'inOutSine',
      alternate: true,
      loop: true,
    });

    animate('#topo-p4', {
      cx: [530, 454],
      duration: 2000,
      ease: 'inOutSine',
      alternate: true,
      loop: true,
    });

    // Zone boundary breathing
    animate('.topo-zone', {
      opacity: [0.3, 0.5],
      duration: 3000,
      ease: 'inOutQuad',
      alternate: true,
      loop: true,
    });

    // Node breathing glow
    animate('.arch-node', {
      strokeOpacity: [0.6, 1],
      duration: 2500,
      ease: 'inOutQuad',
      alternate: true,
      loop: true,
    });

    // Connection line dash animation
    animate('.arch-line', {
      strokeDashoffset: [0, -20],
      duration: 1500,
      ease: 'linear',
      loop: true,
    });
  });
</script>
