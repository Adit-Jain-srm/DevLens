---
import { contextGraph } from '../data/content';
---

<section class="py-24 sm:py-32 bg-[#050508] border-b border-white/[0.06] relative overflow-hidden">
  <div class="absolute inset-0 grid-subtle opacity-10 pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 scroll-reveal">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#EC4899]/10 border border-[#EC4899]/30 text-xs font-mono text-[#EC4899] mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-[#EC4899]"></span>
        <span>{contextGraph.eyebrow}</span>
      </div>
      <h2 class="display-section text-white tracking-tight">
        {contextGraph.title}
      </h2>
      <p class="mt-4 text-sm sm:text-base text-zinc-400 leading-relaxed">
        {contextGraph.subtitle}
      </p>
    </div>

    <!-- Signal Cards -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 max-w-5xl mx-auto scroll-reveal-group">
      {contextGraph.signals.map((signal) => (
        <div class="dl-card rounded-xl p-5 scroll-reveal group gradient-border">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-2xl transition-transform duration-300 group-hover:scale-110">{signal.icon}</span>
            <div>
              <h3 class="font-heading font-bold text-white text-sm">{signal.name}</h3>
              <p class="font-mono text-[10px]" style={`color: ${signal.accent}`}>{signal.source}</p>
            </div>
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed italic">"{signal.example}"</p>
        </div>
      ))}
    </div>

    <!-- Graph Visualization -->
    <div class="mt-12 max-w-3xl mx-auto scroll-reveal">
      <div class="dl-card rounded-2xl p-6 sm:p-8 dl-card-active">
        <div class="text-[10px] font-mono font-bold text-zinc-400 uppercase tracking-wider mb-5">HOW SIGNALS CONNECT</div>

        <div class="relative">
          <svg class="w-full h-48" viewBox="0 0 600 180" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Center hub -->
            <circle cx="300" cy="90" r="30" fill="#0C0D14" stroke="#00D4FF" stroke-width="1.5" class="arch-node" />
            <text x="300" y="86" text-anchor="middle" fill="#00D4FF" font-family="JetBrains Mono, monospace" font-size="8" font-weight="700">CONTEXT</text>
            <text x="300" y="98" text-anchor="middle" fill="#00D4FF" font-family="JetBrains Mono, monospace" font-size="7">GRAPH</text>

            <!-- Signal nodes arranged around center -->
            <!-- Visual -->
            <circle cx="120" cy="40" r="18" fill="#0C0D14" stroke="#00D4FF" stroke-width="1" />
            <text x="120" y="44" text-anchor="middle" fill="#00D4FF" font-family="JetBrains Mono, monospace" font-size="7">Visual</text>
            <line x1="138" y1="48" x2="272" y2="82" stroke="#00D4FF" stroke-width="0.8" stroke-dasharray="4 3" class="arch-line" />

            <!-- Auditory -->
            <circle cx="120" cy="140" r="18" fill="#0C0D14" stroke="#8B5CF6" stroke-width="1" />
            <text x="120" y="144" text-anchor="middle" fill="#8B5CF6" font-family="JetBrains Mono, monospace" font-size="7">Voice</text>
            <line x1="138" y1="132" x2="272" y2="98" stroke="#8B5CF6" stroke-width="0.8" stroke-dasharray="4 3" class="arch-line" />

            <!-- Code -->
            <circle cx="480" cy="40" r="18" fill="#0C0D14" stroke="#F59E0B" stroke-width="1" />
            <text x="480" y="44" text-anchor="middle" fill="#F59E0B" font-family="JetBrains Mono, monospace" font-size="7">Code</text>
            <line x1="462" y1="48" x2="328" y2="82" stroke="#F59E0B" stroke-width="0.8" stroke-dasharray="4 3" class="arch-line" />

            <!-- Runtime -->
            <circle cx="480" cy="140" r="18" fill="#0C0D14" stroke="#10B981" stroke-width="1" />
            <text x="480" y="144" text-anchor="middle" fill="#10B981" font-family="JetBrains Mono, monospace" font-size="7">Runtime</text>
            <line x1="462" y1="132" x2="328" y2="98" stroke="#10B981" stroke-width="0.8" stroke-dasharray="4 3" class="arch-line" />

            <!-- Temporal -->
            <circle cx="220" cy="170" r="18" fill="#0C0D14" stroke="#EC4899" stroke-width="1" />
            <text x="220" y="174" text-anchor="middle" fill="#EC4899" font-family="JetBrains Mono, monospace" font-size="7">Git</text>
            <line x1="235" y1="158" x2="285" y2="115" stroke="#EC4899" stroke-width="0.8" stroke-dasharray="4 3" class="arch-line" />

            <!-- Human -->
            <circle cx="380" cy="170" r="18" fill="#0C0D14" stroke="#EF4444" stroke-width="1" />
            <text x="380" y="174" text-anchor="middle" fill="#EF4444" font-family="JetBrains Mono, monospace" font-size="7">Memory</text>
            <line x1="365" y1="158" x2="315" y2="115" stroke="#EF4444" stroke-width="0.8" stroke-dasharray="4 3" class="arch-line" />
          </svg>
        </div>

        <div class="mt-4 text-center">
          <p class="text-xs text-zinc-500 font-mono">
            Graph-guided investigation: <strong class="text-white">+25pp</strong> root-cause accuracy over baselines
            <span class="text-zinc-600 ml-1">(GALA+ 2026)</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
