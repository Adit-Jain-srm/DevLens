---
import { hackTrackerAlignment } from '../data/content';
---

<section id="scoring" class="py-24 sm:py-32 bg-[#050508] border-b border-white/[0.06] relative overflow-hidden">
  <div class="absolute inset-0 grid-subtle opacity-10 pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 scroll-reveal">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#F59E0B]/10 border border-[#F59E0B]/30 text-xs font-mono text-[#F59E0B] mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-[#F59E0B] animate-pulse"></span>
        <span>{hackTrackerAlignment.eyebrow}</span>
      </div>
      <h2 class="display-section text-white tracking-tight">
        {hackTrackerAlignment.title}
      </h2>
      <p class="mt-4 text-sm sm:text-base text-zinc-400 leading-relaxed">
        {hackTrackerAlignment.subtitle}
      </p>
    </div>

    <!-- Scoring Breakdown -->
    <div class="max-w-4xl mx-auto space-y-3 mb-16 scroll-reveal-group">
      {hackTrackerAlignment.scoring.map((item) => (
        <div class="dl-card rounded-xl p-5 scroll-reveal group">
          <div class="flex flex-col sm:flex-row sm:items-center gap-4">

            <!-- Weight + Name -->
            <div class="flex items-center gap-3 sm:w-56 shrink-0">
              <div
                class="w-12 h-12 rounded-xl flex items-center justify-center font-mono text-xs font-bold shrink-0"
                style={`background: ${item.accent}15; color: ${item.accent}; border: 1px solid ${item.accent}30`}
              >
                {item.weight}
              </div>
              <div>
                <div class="font-heading font-bold text-white text-sm">{item.criterion}</div>
              </div>
            </div>

            <!-- Alignment -->
            <div class="flex-1 min-w-0">
              <p class="text-xs text-zinc-400 leading-relaxed">{item.alignment}</p>
            </div>

            <!-- Score -->
            <div class="shrink-0">
              <span
                class="px-3 py-1 rounded-full text-[10px] font-mono font-bold tracking-wider"
                style={`color: ${item.accent}; background: ${item.accent}15; border: 1px solid ${item.accent}30`}
              >
                {item.score}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Total bar -->
    <div class="max-w-4xl mx-auto mb-16 scroll-reveal">
      <div class="dl-card rounded-xl p-5 dl-card-active">
        <div class="flex items-center justify-between mb-3">
          <span class="font-mono text-xs font-bold text-zinc-400 uppercase tracking-wider">TOTAL SCORING COVERAGE</span>
          <span class="font-mono text-lg font-bold text-[#00D4FF]">100%</span>
        </div>
        <div class="h-3 rounded-full bg-white/[0.06] overflow-hidden flex">
          <div class="h-full bg-[#00D4FF]" style="width: 30%"></div>
          <div class="h-full bg-[#8B5CF6]" style="width: 20%"></div>
          <div class="h-full bg-[#10B981]" style="width: 15%"></div>
          <div class="h-full bg-[#F59E0B]" style="width: 15%"></div>
          <div class="h-full bg-[#EC4899]" style="width: 10%"></div>
          <div class="h-full bg-[#EF4444]" style="width: 10%"></div>
        </div>
        <div class="flex flex-wrap gap-3 mt-3">
          <span class="text-[9px] font-mono text-zinc-500 flex items-center gap-1"><span class="w-2 h-2 rounded-sm bg-[#00D4FF]"></span>Product 30%</span>
          <span class="text-[9px] font-mono text-zinc-500 flex items-center gap-1"><span class="w-2 h-2 rounded-sm bg-[#8B5CF6]"></span>Novelty 20%</span>
          <span class="text-[9px] font-mono text-zinc-500 flex items-center gap-1"><span class="w-2 h-2 rounded-sm bg-[#10B981]"></span>Phone Use 15%</span>
          <span class="text-[9px] font-mono text-zinc-500 flex items-center gap-1"><span class="w-2 h-2 rounded-sm bg-[#F59E0B]"></span>Tech Depth 15%</span>
          <span class="text-[9px] font-mono text-zinc-500 flex items-center gap-1"><span class="w-2 h-2 rounded-sm bg-[#EC4899]"></span>Office Kit 10%</span>
          <span class="text-[9px] font-mono text-zinc-500 flex items-center gap-1"><span class="w-2 h-2 rounded-sm bg-[#EF4444]"></span>Demo 10%</span>
        </div>
      </div>
    </div>

    <!-- Red Light + Brownie Points Grid -->
    <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto scroll-reveal">

      <!-- Red Light Strategy -->
      <div class="dl-card rounded-xl p-6 gradient-border">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-xl">🔴</span>
          <div>
            <h3 class="font-heading font-bold text-white text-sm">{hackTrackerAlignment.redLightStrategy.title}</h3>
            <p class="font-mono text-[10px] text-zinc-500">{hackTrackerAlignment.redLightStrategy.subtitle}</p>
          </div>
        </div>
        <ol class="space-y-2.5">
          {hackTrackerAlignment.redLightStrategy.steps.map((step, idx) => (
            <li class="flex items-start gap-2.5 text-xs text-zinc-400">
              <span class="font-mono text-[10px] font-bold text-[#EF4444] mt-0.5 shrink-0">{idx + 1}.</span>
              <span class="leading-relaxed">{step}</span>
            </li>
          ))}
        </ol>
      </div>

      <!-- Brownie Points -->
      <div class="dl-card rounded-xl p-6 gradient-border">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-xl">⭐</span>
          <div>
            <h3 class="font-heading font-bold text-white text-sm">{hackTrackerAlignment.browniePoints.title}</h3>
            <p class="font-mono text-[10px] text-zinc-500">Local/open-source model at the core</p>
          </div>
        </div>
        <ul class="space-y-2.5">
          {hackTrackerAlignment.browniePoints.items.map((item) => (
            <li class="flex items-start gap-2.5 text-xs text-zinc-400">
              <span class="text-[#10B981] mt-0.5 shrink-0">✓</span>
              <span class="leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Source -->
    <div class="mt-8 text-center scroll-reveal">
      <a href="https://iqoo.reskilll.com/guide" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/[0.03] border border-white/[0.08] text-xs font-mono text-zinc-400 hover:text-white hover:border-white/20 transition-all">
        <span>📋</span>
        <span>Scoring rubric from official iQOO Hackathon Guide ↗</span>
      </a>
    </div>
  </div>
</section>
