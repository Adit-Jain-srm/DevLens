---
import { team, site } from '../data/content';
---

<section id="team" class="py-24 sm:py-32 bg-[#050508] border-b border-white/[0.06] relative overflow-hidden">
  <div class="absolute inset-0 grid-subtle opacity-10 pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 scroll-reveal">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/[0.06] border border-white/10 text-xs font-mono text-zinc-400 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-white/40"></span>
        <span>{team.eyebrow}</span>
      </div>
      <h2 class="display-section text-white tracking-tight">
        {team.name}
      </h2>
      <p class="mt-4 text-sm sm:text-base text-zinc-400 leading-relaxed">
        {team.tagline}
      </p>
    </div>

    <!-- Team Members -->
    <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto scroll-reveal-group">
      {team.members.map((member) => (
        <div class="dl-card rounded-xl p-6 text-center scroll-reveal">
          <!-- Avatar -->
          <div class="w-20 h-20 mx-auto mb-5 rounded-2xl bg-gradient-to-br from-[#00D4FF]/20 to-[#8B5CF6]/20 border border-white/[0.08] flex items-center justify-center">
            <span class="font-heading font-bold text-2xl text-white">
              {member.name.split(' ').map(n => n[0]).join('')}
            </span>
          </div>

          <!-- Badge -->
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-[#00D4FF]/10 border border-[#00D4FF]/30 text-[9px] font-mono font-bold text-[#00D4FF] tracking-wider mb-3">
            {member.badge}
          </div>

          <h3 class="font-heading font-bold text-white text-base mb-1">{member.name}</h3>
          <p class="font-mono text-xs text-zinc-400 mb-3">{member.title}</p>
          <p class="text-[11px] text-zinc-500 leading-relaxed">{member.focus}</p>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-16 text-center scroll-reveal">
      <div class="dl-card inline-flex flex-col items-center gap-5 rounded-2xl p-8 sm:p-10 max-w-xl mx-auto dl-card-active">
        <h3 class="display-lg text-white">{site.tagline}</h3>
        <p class="text-sm text-zinc-400 leading-relaxed">
          The first developer tool with eyes and ears. Built for the {site.hackathon}, {site.event}.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href={site.github}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-full font-mono text-sm font-bold bg-white text-black hover:bg-zinc-200 transition-all active:scale-95"
          >
            View on GitHub
          </a>
          <a
            href="#how-it-works"
            class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-full font-mono text-sm font-semibold bg-[#0C0D14] text-zinc-300 border border-white/10 hover:border-white/20 hover:text-white transition-all active:scale-95"
          >
            Watch Demo
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
