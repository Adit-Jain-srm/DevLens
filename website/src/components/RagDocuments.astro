---
import { ragDocuments } from '../data/content';
---

<section id="rag" class="py-24 sm:py-32 bg-[#0A0A0F] border-b border-white/[0.06] relative overflow-hidden">
  <div class="absolute inset-0 grid-dense opacity-10 pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 scroll-reveal">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0EA5E9]/10 border border-[#0EA5E9]/30 text-xs font-mono text-[#0EA5E9] mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-[#0EA5E9]"></span>
        <span>{ragDocuments.eyebrow}</span>
      </div>
      <h2 class="display-section text-white tracking-tight">
        {ragDocuments.title}
      </h2>
      <p class="mt-4 text-sm sm:text-base text-zinc-400 leading-relaxed">
        {ragDocuments.subtitle}
      </p>
    </div>

    <!-- Upload Sources -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-4xl mx-auto mb-12 scroll-reveal-group">
      {ragDocuments.uploadSources.map((src) => (
        <div class="dl-card rounded-xl p-4 text-center scroll-reveal group">
          <span class="text-2xl block mb-2 transition-transform duration-300 group-hover:scale-110">{src.icon}</span>
          <h4 class="font-heading font-bold text-white text-xs mb-1">{src.source}</h4>
          <p class="text-[10px] text-zinc-500 leading-relaxed">{src.description}</p>
        </div>
      ))}
    </div>

    <!-- Supported Formats -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-16 scroll-reveal">
      {ragDocuments.supportedFormats.map((fmt) => (
        <span class="px-3 py-1 rounded-full text-[10px] font-mono font-bold text-[#0EA5E9] bg-[#0EA5E9]/10 border border-[#0EA5E9]/20">
          {fmt}
        </span>
      ))}
    </div>

    <!-- Use Cases -->
    <div class="grid sm:grid-cols-2 gap-5 max-w-4xl mx-auto mb-16 scroll-reveal-group">
      {ragDocuments.useCases.map((uc) => (
        <div class="dl-card rounded-xl p-6 scroll-reveal group gradient-border">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-xl transition-transform duration-300 group-hover:scale-110">{uc.icon}</span>
            <h3 class="font-heading font-bold text-white text-sm">{uc.title}</h3>
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed mb-3">{uc.description}</p>
          <div class="rounded-lg bg-black/40 border border-white/[0.06] p-3">
            <div class="text-[9px] font-mono font-bold uppercase tracking-wider mb-1" style={`color: ${uc.accent}`}>EXAMPLE</div>
            <p class="text-[11px] text-zinc-500 font-mono leading-relaxed italic">{uc.example}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- RAG Pipeline -->
    <div class="max-w-3xl mx-auto scroll-reveal">
      <div class="dl-card rounded-2xl p-6 sm:p-8 dl-card-active">
        <div class="text-[10px] font-mono font-bold text-zinc-400 uppercase tracking-wider mb-5">RAG PIPELINE</div>
        <div class="space-y-3">
          {ragDocuments.pipeline.map((step, idx) => (
            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-lg bg-[#0EA5E9]/10 border border-[#0EA5E9]/20 flex items-center justify-center shrink-0 font-mono text-[10px] font-bold text-[#0EA5E9]">
                {idx + 1}
              </div>
              <p class="text-xs text-zinc-400 leading-relaxed pt-1 font-mono">{step}</p>
            </div>
          ))}
        </div>
        <div class="mt-5 pt-4 border-t border-white/[0.06] text-center">
          <p class="text-[10px] font-mono text-zinc-500">
            All indexing runs locally — documents never leave your machine. Vector store lives on the laptop daemon.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
