---
import { gitIntegration } from '../data/content';
---

<section id="git" class="py-24 sm:py-32 bg-[#050508] border-b border-white/[0.06] relative overflow-hidden">
  <div class="absolute inset-0 grid-subtle opacity-10 pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 scroll-reveal">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#A855F7]/10 border border-[#A855F7]/30 text-xs font-mono text-[#A855F7] mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-[#A855F7]"></span>
        <span>{gitIntegration.eyebrow}</span>
      </div>
      <h2 class="display-section text-white tracking-tight">
        {gitIntegration.title}
      </h2>
      <p class="mt-4 text-sm sm:text-base text-zinc-400 leading-relaxed">
        {gitIntegration.subtitle}
      </p>
    </div>

    <!-- Git Capabilities -->
    <div class="max-w-4xl mx-auto space-y-6 scroll-reveal-group">
      {gitIntegration.capabilities.map((cap, idx) => (
        <div class="dl-card rounded-xl overflow-hidden scroll-reveal group">
          <div class="flex flex-col lg:flex-row">
            <!-- Left: Title + Description -->
            <div class="p-6 lg:w-1/2 flex flex-col justify-center">
              <div class="flex items-center gap-3 mb-4">
                <span class="text-2xl transition-transform duration-300 group-hover:scale-110">{cap.icon}</span>
                <h3 class="font-heading font-bold text-white text-base">{cap.title}</h3>
              </div>
              <p class="text-xs text-zinc-400 leading-relaxed">{cap.description}</p>
            </div>

            <!-- Right: Technical Details -->
            <div class="p-6 lg:w-1/2 bg-black/30 border-t lg:border-t-0 lg:border-l border-white/[0.04]">
              <div class="text-[9px] font-mono font-bold uppercase tracking-wider mb-3" style={`color: ${cap.accent}`}>TECHNICAL DETAILS</div>
              <ul class="space-y-2">
                {cap.details.map((detail) => (
                  <li class="flex items-start gap-2 text-[11px] text-zinc-400 leading-relaxed">
                    <span class="mt-1 shrink-0" style={`color: ${cap.accent}`}>→</span>
                    <span class="font-mono">{detail}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Graph Visualization -->
    <div class="mt-12 max-w-3xl mx-auto scroll-reveal">
      <div class="dl-card rounded-2xl p-6 sm:p-8">
        <div class="text-[10px] font-mono font-bold text-zinc-400 uppercase tracking-wider mb-5">BLAST-RADIUS EXAMPLE</div>
        <div class="relative w-full" style="aspect-ratio: 600 / 200;">
          <svg class="w-full h-full" viewBox="0 0 600 200" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Central changed function -->
            <rect x="230" y="70" width="140" height="60" rx="10" fill="#0A0E18" stroke="#EF4444" stroke-width="2" class="arch-node" />
            <text x="300" y="94" text-anchor="middle" fill="#EF4444" font-family="JetBrains Mono, monospace" font-size="8" font-weight="700">auth.validate()</text>
            <text x="300" y="110" text-anchor="middle" fill="#EF4444" font-family="JetBrains Mono, monospace" font-size="6" opacity="0.6">CHANGED · 9 call sites</text>
            <text x="300" y="122" text-anchor="middle" fill="#F59E0B" font-family="JetBrains Mono, monospace" font-size="6" font-weight="700">HIGH RISK</text>

            <!-- Callers (left) -->
            <rect x="20" y="20" width="120" height="36" rx="6" fill="#0C0D14" stroke="#F59E0B" stroke-width="0.8" />
            <text x="80" y="38" text-anchor="middle" fill="#F59E0B" font-family="JetBrains Mono, monospace" font-size="7">routes/profile</text>
            <text x="80" y="50" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="5.5">caller · 3 refs</text>
            <line x1="140" y1="38" x2="230" y2="90" stroke="#F59E0B" stroke-width="0.8" stroke-dasharray="4 2" class="arch-line" />

            <rect x="20" y="72" width="120" height="36" rx="6" fill="#0C0D14" stroke="#F59E0B" stroke-width="0.8" />
            <text x="80" y="90" text-anchor="middle" fill="#F59E0B" font-family="JetBrains Mono, monospace" font-size="7">routes/settings</text>
            <text x="80" y="102" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="5.5">caller · 2 refs</text>
            <line x1="140" y1="90" x2="230" y2="100" stroke="#F59E0B" stroke-width="0.8" stroke-dasharray="4 2" class="arch-line" />

            <rect x="20" y="124" width="120" height="36" rx="6" fill="#0C0D14" stroke="#F59E0B" stroke-width="0.8" />
            <text x="80" y="142" text-anchor="middle" fill="#F59E0B" font-family="JetBrains Mono, monospace" font-size="7">routes/api</text>
            <text x="80" y="154" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="5.5">caller · 4 refs</text>
            <line x1="140" y1="142" x2="230" y2="100" stroke="#F59E0B" stroke-width="0.8" stroke-dasharray="4 2" class="arch-line" />

            <!-- Callees (right) -->
            <rect x="460" y="40" width="120" height="36" rx="6" fill="#0C0D14" stroke="#10B981" stroke-width="0.8" />
            <text x="520" y="58" text-anchor="middle" fill="#10B981" font-family="JetBrains Mono, monospace" font-size="7">jwt.verify()</text>
            <text x="520" y="70" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="5.5">callee · safe</text>
            <line x1="370" y1="90" x2="460" y2="58" stroke="#10B981" stroke-width="0.8" stroke-dasharray="4 2" class="arch-line" />

            <rect x="460" y="100" width="120" height="36" rx="6" fill="#0C0D14" stroke="#10B981" stroke-width="0.8" />
            <text x="520" y="118" text-anchor="middle" fill="#10B981" font-family="JetBrains Mono, monospace" font-size="7">db.findUser()</text>
            <text x="520" y="130" text-anchor="middle" fill="#475569" font-family="JetBrains Mono, monospace" font-size="5.5">callee · safe</text>
            <line x1="370" y1="100" x2="460" y2="118" stroke="#10B981" stroke-width="0.8" stroke-dasharray="4 2" class="arch-line" />

            <!-- Type defs (bottom) -->
            <rect x="230" y="155" width="140" height="30" rx="6" fill="#0C0D14" stroke="#8B5CF6" stroke-width="0.8" />
            <text x="300" y="174" text-anchor="middle" fill="#8B5CF6" font-family="JetBrains Mono, monospace" font-size="7">AuthUser (type)</text>
            <line x1="300" y1="130" x2="300" y2="155" stroke="#8B5CF6" stroke-width="0.8" stroke-dasharray="3 2" class="arch-line" />

            <!-- Labels -->
            <text x="80" y="14" text-anchor="middle" fill="#F59E0B" font-family="JetBrains Mono, monospace" font-size="6" opacity="0.5">CALLERS (9 sites)</text>
            <text x="520" y="34" text-anchor="middle" fill="#10B981" font-family="JetBrains Mono, monospace" font-size="6" opacity="0.5">CALLEES (2)</text>
            <text x="300" y="198" text-anchor="middle" fill="#8B5CF6" font-family="JetBrains Mono, monospace" font-size="6" opacity="0.5">TYPE DEFS (1)</text>
          </svg>
        </div>
        <div class="mt-4 flex items-center justify-center gap-4 text-[9px] font-mono text-zinc-500">
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-sm bg-[#EF4444]/30 border border-[#EF4444]/40"></span> Changed function</span>
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-sm bg-[#F59E0B]/30 border border-[#F59E0B]/40"></span> Callers (at risk)</span>
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-sm bg-[#10B981]/30 border border-[#10B981]/40"></span> Callees (safe)</span>
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-sm bg-[#8B5CF6]/30 border border-[#8B5CF6]/40"></span> Type definitions</span>
        </div>
      </div>
    </div>
  </div>
</section>
