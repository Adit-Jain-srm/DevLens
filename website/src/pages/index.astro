---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProblemSection from '../components/ProblemSection.astro';
import HowItWorks from '../components/HowItWorks.astro';
import DebugPipeline from '../components/DebugPipeline.astro';
import Architecture from '../components/Architecture.astro';
import ContextGraph from '../components/ContextGraph.astro';
import Features from '../components/Features.astro';
import Modes from '../components/Modes.astro';
import Comparison from '../components/Comparison.astro';
import Guardrails from '../components/Guardrails.astro';
import Research from '../components/Research.astro';
import TechStack from '../components/TechStack.astro';
import TeamSection from '../components/TeamSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main class="flex-1 bg-[#0A0A0F]">
    <Hero />
    <ProblemSection />
    <HowItWorks />
    <DebugPipeline />
    <Architecture />
    <ContextGraph />
    <Features />
    <Modes />
    <Comparison />
    <Guardrails />
    <Research />
    <TechStack />
    <TeamSection />
  </main>
  <Footer />
</BaseLayout>
